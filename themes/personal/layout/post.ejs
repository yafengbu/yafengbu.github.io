<article class="post">
  <header class="post-header">
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <time><%= date(page.date, 'YYYY-MM-DD') %></time>
      <% (page.tags || []).forEach(function (tag) { %>
      <span class="pill"><%= tag.name %></span>
      <% }); %>
    </div>
  </header>
  <div class="post-content">
    <%- page.content %>
  </div>
  <nav class="post-nav">
    <% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %>
    <% if (page.next) { %><a class="nav-next" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %>
  </nav>
</article>
